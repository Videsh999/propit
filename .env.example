# ---- Nivasa environment ----
# Everything below is OPTIONAL. Nivasa runs fully without any of it:
# the basemap is keyless, geocoding falls back to local data, travel times are
# labelled estimates, and the assistant runs a deterministic concierge.

# Assistant (conversational answers + tool use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Basemap ----
# Nivasa falls through a chain of providers, none of which need a key:
#
#   OpenFreeMap (vector)  ->  Esri Light Gray (raster)  ->  OpenStreetMap (raster)
#
# CARTO is deliberately not in that chain. As of 2026 their keyless raster tiles
# — Positron and Voyager alike — are returned stamped "API KEY REQUIRED" across
# the whole image.
#
# OpenFreeMap leads because it is free, unwatermarked, and serves its style,
# sprites, glyphs and tiles from a single origin. A split-origin provider can
# leave the style waiting forever on one blocked host, which renders a blank map
# rather than a degraded one.
#
# To use a paid or self-hosted provider, set ONE of the following. It takes
# precedence and the public providers stay behind it as a safety net.
#
#   Vector style JSON (MapTiler, Mapbox, your own):
#     NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/dataviz-light/style.json?key=YOUR_KEY
#   Raster tile template:
#     NEXT_PUBLIC_MAP_TILE_URL=https://tiles.yourdomain.com/{z}/{x}/{y}.png
#
# Google Maps tiles cannot be used here. Google's Terms of Service only permit
# their map data through the Google Maps JavaScript API, which is a different
# library from MapLibre. MapTiler and Mapbox are the closest drop-in equivalents.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Geocoding: "photon" (default, keyless OSM) or "local" (Nivasa data only)
GEOCODING_PROVIDER=photon

# Routing: unset for straight-line estimates, or "ors" with a key for real
# driving times and isochrones. Estimates are always labelled as such in the UI.
ROUTING_PROVIDER=
ORS_API_KEY=

# Canonical URL for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production database (PostGIS). Unset in development — Nivasa uses its
# in-memory spatial store, which implements the same repository interface.
DATABASE_URL=
